# 飞书应用配置
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=xxx

# AI/Codex API 配置（可选，不配置则使用 Codex CLI）
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# AI 调用参数
AI_TIMEOUT=30
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# HTTP 服务配置
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Bot 配置文件路径（可选，默认使用 config/feishu_codex_bot.json）
BOT_CONFIG=config/feishu_codex_bot.json
